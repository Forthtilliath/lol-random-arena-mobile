{
	"expo": {
		"name": "LoL Random Arena",
		"slug": "reactnative-lol-random-arena",
		"version": "1.0.0",
		"scheme": "lolrandomarena",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#010A13",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"package": "com.forthtilliath.lolrandomarena",
			"adaptiveIcon": {
				"backgroundColor": "#010A13",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"blockedPermissions": [
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE"
			]
		},
		"web": {
			"favicon": "./assets/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			"expo-image",
			"expo-font",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#010A13",
					"image": "./assets/splash-icon.png",
					"imageWidth": 180
				}
			],
			[
				"@forthtilliath/expo-config-plugins/withReleaseSigning",
				{ "propertyPrefix": "LOLRANDOMARENA" }
			],
			"@forthtilliath/expo-config-plugins/withAndroidAbis"
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
